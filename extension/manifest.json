{
  "manifest_version": 3,
  "name": "Agent Bridge MCP",
  "version": "1.0.0",
  "description": "Multi-profile browser control, deterministic DOM ref targeting, and CDP debugging bridge for Antigravity & MCP agents.",
  "permissions": [
    "tabs",
    "debugger",
    "scripting",
    "activeTab",
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Agent Bridge MCP"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
